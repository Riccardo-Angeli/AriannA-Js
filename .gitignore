# ─────────────────────────────────────────────────────────────────────────────
# AriannA JS 2.0 — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# OS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory
.Trash-*

# IDE / editors
.idea/
.vscode/
*.swp
*.swo
.project
.settings/
*.sublime-project
*.sublime-workspace

# Node / package managers
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn-integrity
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# AriannA generated/cache
.arianna-cache/
.cache/
.parcel-cache/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Generated JS beside TypeScript sources
additionals/**/*.js
components/**/*.js
core/**/*.js
config/**/*.js
cli/**/*.js

# Generated declarations
types/
additionals/**/*.d.ts
components/**/*.d.ts
core/**/*.d.ts
config/**/*.d.ts
cli/**/*.d.ts

# Sourcemaps generated beside source
additionals/**/*.js.map
components/**/*.js.map
core/**/*.js.map
config/**/*.js.map
cli/**/*.js.map

# Release
release/**
!release/dist/
!release/dist/**
!release/benchmarks/
!release/benchmarks/**

# Generic build output
dist/
build/
out/
coverage/
.nyc_output/

# Rust / Tauri
target/
**/target/
**/src-tauri/target/
**/src-tauri/gen/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Logs
logs/
*.log

# Package artefacts
*.tgz

# Private / internal documentation
documentation/internal/
documentation/private/
documentation/private documentation/
**/*.local.md
**/*.local.ts

# Local strategic/project files
3D_ENTERPRISE_ROADMAP.md
PROJECT_STRUCTURE.txt
REPO_STRUCTURE.md

# Devtools — local development only
devtools/

# Generated audit / temporary scripts
scripts/AUDIT.json

# Benchmark generated files
benchmark/keyed/index.html
benchmark/non-keyed/index.html
benchmark/keyed/src/Main.js
benchmark/non-keyed/src/Main.js

# Local/private schema notes
schema/Atlas-Logos-IR-Renderers-Blueprint-Draft.md