<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="urn:alchemia:logos:2"
           targetNamespace="urn:alchemia:logos:2"
           elementFormDefault="qualified" version="1.1">
  <xs:annotation><xs:documentation>Logos IR 2.1 canonical XML transport projection. The JSON Schema remains the exhaustive structural projection; this XSD strictly validates document framing, identifiers, definition discriminants, typed values, references and integrity envelopes.</xs:documentation></xs:annotation>
  <xs:simpleType name="Id"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:pattern value="[A-Za-z0-9][A-Za-z0-9._:/-]*"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="SchemaVersion"><xs:restriction base="xs:string"><xs:pattern value="[0-9]+\.[0-9]+\.[0-9]+([+-][A-Za-z0-9.-]+)?"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="DefinitionKind"><xs:restriction base="xs:string"><xs:enumeration value="namespace"/><xs:enumeration value="dialect"/><xs:enumeration value="platform"/><xs:enumeration value="target"/><xs:enumeration value="policy"/><xs:enumeration value="type"/><xs:enumeration value="style"/><xs:enumeration value="node"/><xs:enumeration value="component"/><xs:enumeration value="event"/><xs:enumeration value="event-target"/><xs:enumeration value="event-handler"/><xs:enumeration value="event-code"/><xs:enumeration value="event-binding"/><xs:enumeration value="event-broker"/><xs:enumeration value="signal"/><xs:enumeration value="binding"/><xs:enumeration value="expression"/><xs:enumeration value="mapping"/><xs:enumeration value="action"/><xs:enumeration value="tensor"/><xs:enumeration value="operation"/><xs:enumeration value="graph"/><xs:enumeration value="device"/><xs:enumeration value="vision-operation"/><xs:enumeration value="neural-model"/><xs:enumeration value="quantization"/><xs:enumeration value="model-transform"/><xs:enumeration value="constraint"/><xs:enumeration value="rewrite"/><xs:enumeration value="pass"/><xs:enumeration value="pipeline"/><xs:enumeration value="artifact"/><xs:enumeration value="resource"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Stage"><xs:restriction base="xs:string"><xs:enumeration value="HIR"/><xs:enumeration value="MIR"/><xs:enumeration value="LIR"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Profile"><xs:restriction base="xs:string"><xs:enumeration value="open"/><xs:enumeration value="standard"/><xs:enumeration value="regulated"/><xs:enumeration value="safety"/></xs:restriction></xs:simpleType>
  <xs:complexType name="Hash"><xs:attribute name="algorithm" use="required"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="sha256"/><xs:enumeration value="sha384"/><xs:enumeration value="sha512"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="value" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="Value"><xs:choice><xs:element name="Null"/><xs:element name="Boolean" type="xs:boolean"/><xs:element name="Number" type="xs:double"/><xs:element name="String" type="xs:string"/><xs:element name="Array"><xs:complexType><xs:sequence><xs:element name="Value" type="tns:Value" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element><xs:element name="Object"><xs:complexType><xs:sequence><xs:element name="Entry" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:sequence><xs:element name="Value" type="tns:Value"/></xs:sequence><xs:attribute name="key" type="xs:string" use="required"/></xs:complexType></xs:element></xs:sequence></xs:complexType></xs:element></xs:choice></xs:complexType>
  <xs:complexType name="Integrity"><xs:sequence><xs:element name="Hash" type="tns:Hash"/><xs:element name="Certificate" type="xs:string" minOccurs="0" maxOccurs="unbounded"/></xs:sequence><xs:attribute name="canonicalization" type="xs:string" fixed="logos-c14n-v1"/><xs:attribute name="scope" use="required"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="definition"/><xs:enumeration value="fragment"/><xs:enumeration value="program"/><xs:enumeration value="artifact"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="signatureAlgorithm" type="xs:string"/><xs:attribute name="keyId" type="xs:string"/><xs:attribute name="signature" type="xs:string"/></xs:complexType>
  <xs:complexType name="NativeAddress"><xs:attribute name="runtimeId" type="tns:Id" use="required"/><xs:attribute name="type" type="xs:string" use="required"/><xs:attribute name="member" type="xs:string" use="required"/><xs:attribute name="static" type="xs:boolean" use="required"/></xs:complexType>
  <xs:complexType name="Definition"><xs:sequence><xs:element name="Payload" minOccurs="0"><xs:complexType><xs:sequence><xs:element name="Entry" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:sequence><xs:element name="Value" type="tns:Value"/></xs:sequence><xs:attribute name="key" type="xs:string" use="required"/></xs:complexType></xs:element></xs:sequence></xs:complexType></xs:element><xs:element name="NativeAddress" type="tns:NativeAddress" minOccurs="0"/><xs:element name="Integrity" type="tns:Integrity" minOccurs="0"/></xs:sequence><xs:attribute name="id" type="tns:Id" use="required"/><xs:attribute name="kind" type="tns:DefinitionKind" use="required"/><xs:attribute name="dialectId" type="tns:Id" use="required"/><xs:attribute name="version" type="xs:nonNegativeInteger" use="required"/><xs:attribute name="revision" type="xs:nonNegativeInteger"/></xs:complexType>
  <xs:complexType name="Reference"><xs:attribute name="id" type="tns:Id" use="required"/><xs:attribute name="domain" type="xs:string" use="required"/><xs:attribute name="kind" type="tns:DefinitionKind" use="required"/><xs:attribute name="versionRange" type="xs:string"/><xs:attribute name="optional" type="xs:boolean" default="false"/></xs:complexType>
  <xs:complexType name="Requirement"><xs:attribute name="capability" type="xs:string" use="required"/><xs:attribute name="versionRange" type="xs:string"/><xs:attribute name="optional" type="xs:boolean" default="false"/></xs:complexType>
  <xs:complexType name="Fragment"><xs:sequence><xs:element name="Definitions"><xs:complexType><xs:sequence><xs:element name="Definition" type="tns:Definition" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element><xs:element name="References"><xs:complexType><xs:sequence><xs:element name="Reference" type="tns:Reference" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element><xs:element name="Requirements"><xs:complexType><xs:sequence><xs:element name="Requirement" type="tns:Requirement" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element><xs:element name="Integrity" type="tns:Integrity" minOccurs="0"/></xs:sequence><xs:attribute name="schemaVersion" type="tns:SchemaVersion" use="required"/><xs:attribute name="fragmentId" type="tns:Id" use="required"/><xs:attribute name="revision" type="xs:nonNegativeInteger" use="required"/><xs:attribute name="domain" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="Program"><xs:sequence><xs:element name="PlatformId" type="tns:Id" minOccurs="0" maxOccurs="unbounded"/><xs:element name="RootNodeId" type="tns:Id" minOccurs="0" maxOccurs="unbounded"/><xs:element name="Definitions"><xs:complexType><xs:sequence><xs:element name="Definition" type="tns:Definition" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element><xs:element name="UnresolvedReference" type="tns:Reference" minOccurs="0" maxOccurs="unbounded"/><xs:element name="Requirement" type="tns:Requirement" minOccurs="0" maxOccurs="unbounded"/><xs:element name="Integrity" type="tns:Integrity" minOccurs="0"/></xs:sequence><xs:attribute name="schemaVersion" type="tns:SchemaVersion" use="required"/><xs:attribute name="programId" type="tns:Id" use="required"/><xs:attribute name="revision" type="xs:nonNegativeInteger" use="required"/><xs:attribute name="stage" type="tns:Stage" use="required"/><xs:attribute name="profile" type="tns:Profile" use="required"/><xs:attribute name="activePlatformId" type="tns:Id"/><xs:attribute name="targetId" type="tns:Id"/><xs:assert test="if (@stage='HIR') then not(@activePlatformId or @targetId) else if (@stage='MIR') then (@activePlatformId and not(@targetId)) else (@activePlatformId and @targetId and empty(tns:UnresolvedReference))"/></xs:complexType>
  <xs:complexType name="PatchOperation"><xs:sequence><xs:element name="Value" type="tns:Value" minOccurs="0"/></xs:sequence><xs:attribute name="op" use="required"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="add"/><xs:enumeration value="replace"/><xs:enumeration value="remove"/><xs:enumeration value="move"/><xs:enumeration value="test"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="path" type="xs:string" use="required"/><xs:attribute name="from" type="xs:string"/></xs:complexType>
  <xs:complexType name="FragmentPatch"><xs:sequence><xs:element name="Operation" type="tns:PatchOperation" minOccurs="0" maxOccurs="unbounded"/><xs:element name="Integrity" type="tns:Integrity" minOccurs="0"/></xs:sequence><xs:attribute name="schemaVersion" type="tns:SchemaVersion" use="required"/><xs:attribute name="fragmentId" type="tns:Id" use="required"/><xs:attribute name="baseRevision" type="xs:nonNegativeInteger" use="required"/><xs:attribute name="targetRevision" type="xs:nonNegativeInteger" use="required"/></xs:complexType>
  <xs:element name="Fragment" type="tns:Fragment"/><xs:element name="Program" type="tns:Program"/><xs:element name="FragmentPatch" type="tns:FragmentPatch"/>
</xs:schema>
